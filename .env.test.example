# Credenciales de las pruebas E2E de Playwright — PLANTILLA
#
# Copiar este archivo a `.env.test.local` y completar ahí los valores reales.
# `.env.test.local` está en .gitignore y NUNCA se commitea.
# Este archivo (.env.test.example) sí se versiona y va SIEMPRE sin valores.
#
# Reglas:
# - Usar usuarios creados solo para pruebas, jamás cuentas personales ni de clientes reales.
# - Las contraseñas nunca se escriben dentro de los tests: los tests leen estas variables.
# - En GitHub Actions estos mismos nombres se cargan como secrets del repositorio.
#   `process.loadEnvFile()` no pisa variables que ya existan en el entorno, así que
#   en CI mandan los secrets aunque existiera un archivo.

# URL contra la que corren las pruebas (dev local por defecto)
E2E_BASE_URL=http://localhost:3000

# Aislamiento sandbox / producción — solo para las pruebas que ESCRIBEN.
#
# Nombre EXACTO del negocio de pruebas, tal como aparece en la app (por ejemplo
# "Estética Bella Vida"). Una prueba que cree, mueva o cancele algo comprueba antes que la
# sesión pertenezca a ese negocio; si no coincide, falla, y si esta variable está vacía se
# salta. Sin esto, una prueba de escritura podría tocar datos de un negocio real y disparar
# avisos por WhatsApp a clientes de verdad.
#
# Ojo: hoy sandbox y producción comparten proyecto de Supabase y solo los separa business_id.
E2E_SANDBOX_BUSINESS_NAME=

# Administrador de la plataforma SaaS (tabla `platform_admins`) → /plataforma
E2E_PLATFORM_EMAIL=
E2E_PLATFORM_PASSWORD=

# Dueño / administrador del negocio (business_members: OWNER o ADMIN) → /admin
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Profesional del negocio (business_members: PROFESSIONAL) → /profesional
E2E_PROFESSIONAL_EMAIL=
E2E_PROFESSIONAL_PASSWORD=

# Cliente final (no es rol de business_members) → /cliente
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
