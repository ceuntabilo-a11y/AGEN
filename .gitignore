node_modules/
.next/
out/
.env
.env*.local
.env.test
.env.production
npm-debug.log*
.DS_Store
*.tsbuildinfo

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Sesiones guardadas (storageState): contienen cookies de sesión reales
/playwright/.auth/
# Artefactos de playwright-cli: snapshots, logs de consola y estado de sesión
/.playwright/
/.playwright-cli/
# Pruebas desechables de diagnóstico. La convención está en la skill safe-local-autonomy:
# se crean con el prefijo __tmp-, se ejecutan, y al terminar se mueven fuera del repositorio.
# Esta línea es el cinturón por si alguna sobrevive: nunca puede colarse en un commit.
tests/**/__tmp-*
__tmp-*

# Salida del monitor de salud (se regenera en cada ejecución, local o en CI)
/monitor-salud.json
# Observación anterior del watchdog: es estado de una máquina concreta, no del proyecto
/.agen-watchdog.json
