        "jsonOutput": "={{ JSON.stringify((function () {\n  var raw = $('Webhook').first().json;\n  var query = raw.query || {};\n  var body = raw.body || {};\n  var data = body.data || {};\n  var key = data.key || {};\n  var mensaje = data.message || {};\n\n  var remoteJid = key.remoteJid || '';\n  var phoneFromJid = remoteJid.split('@')[0] || '';\n  var evolutionText = mensaje.conversation\n    || (mensaje.extendedTextMessage && mensaje.extendedTextMessage.text)\n    || (mensaje.imageMessage && mensaje.imageMessage.caption)\n    || '';\n\n  var businessId = body.businessId || query.businessId || '';\n  var phone = body.phone || (phoneFromJid ? '+' + phoneFromJid : '');\n  var message = body.message || evolutionText;\n  var sender = body.sender || data.pushName || body.pushName || '';\n\n  var mediaType = mensaje.imageMessage ? 'image' : (mensaje.audioMessage ? 'audio' : (mensaje.pttMessage ? 'audio' : null));\n  var fromMe = Boolean(key.fromMe);\n  var isGroup = /@g\\.us$/i.test(remoteJid) || /@broadcast$/i.test(remoteJid) || /^status@/i.test(remoteJid);\n  var digits = String(phone).replace(/\\D/g, '');\n  var atender = Boolean(businessId) && !isGroup && !fromMe\n    && digits.length >= 8 && digits.length <= 15\n    && (String(message).trim().length > 0 || Boolean(mediaType));\n\n  var ejecucion = $execution && $execution.id ? String($execution.id) : '';\n  var respaldoId = ejecucion\n    ? 'exec-' + ejecucion\n    : 'ts-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);\n  var messageId = String(key.id || body.messageId || query.messageId || respaldoId).slice(0, 120);\n\n  return {\n    body: { businessId: businessId, phone: phone, message: message, sender: sender },\n    headers: raw.headers || {},\n    fromMe: fromMe,\n    isGroup: isGroup,\n    atender: atender,\n    messageKey: data.key || null,\n    messageId: messageId,\n    instance: body.instance || (raw.body && raw.body.instance) || 'Agen',\n    mediaType: mediaType\n  };\n})()) }}",
        "options": {}
      },
