{
  "//": "saveDataSuccessExecution va en 'all' a propósito. Con 'none' este workflow llevaba horas corriendo bien y desde fuera era indistinguible de uno que nunca se disparó: cero ejecuciones registradas. Para una automatización que nadie mira, 'ha funcionado' tiene que poder comprobarse. Verificable sin esperar una hora con: npm run n8n -- probar-programado <id>",
  "name": "AGEN 04 - Seguimiento y resumen diario",
  "nodes": [
    {
      "id": "1dcd3273-fd7f-430c-9f25-d2fe9864bd8e",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [260, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 1, "triggerAtMinute": 5 }
          ]
        }
      }
    },
    {
      "id": "53be7ef8-88e1-4a41-b1a7-5a4745f39f24",
      "name": "Generar seguimiento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [520, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{$env.AGEN_APP_URL + '/api/automation/followups/run'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-agen-secret", "value": "={{$env.AGEN_WEBHOOK_SECRET}}" }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": { "response": { "neverError": false, "responseFormat": "json" } }
        }
      }
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [[{ "node": "Generar seguimiento", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "timezone": "America/Santiago"
  }
}
